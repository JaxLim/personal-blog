---
/**
 * A figure for posts: an image (optimised, click to enlarge) or anything
 * passed as children, such as an inline SVG diagram, with a caption.
 *
 *   import shot from './shot.png';
 *   <Figure src={shot} alt="…" caption="…" />
 *   <Figure caption="…" wide><svg>…</svg></Figure>
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  caption?: string;
  /** Let the figure grow wider than the text column on large screens. */
  wide?: boolean;
  /** Draw a quiet frame around it (screenshots). */
  framed?: boolean;
}

const { src, alt = '', caption, wide = false, framed = false } = Astro.props;
---

<figure class:list={['figure', { 'figure--wide': wide, 'figure--framed': framed }]}>
  <div class="figure__media">
    {src ? <Image src={src} alt={alt} widths={[640, 960, 1440]} sizes="(min-width: 64rem) 48rem, 92vw" /> : <slot />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: 2.2em;
  }

  @media (min-width: 64rem) {
    .figure--wide {
      margin-inline: -4rem;
    }
  }

  .figure__media {
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .figure--framed .figure__media {
    border: 1px solid var(--hairline);
    box-shadow: 0 24px 48px -32px rgb(21 23 28 / 0.3);
  }

  .figure__media :global(img),
  .figure__media :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--graphite);
    text-align: center;
  }
</style>
