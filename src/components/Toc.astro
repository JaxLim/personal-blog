---
import type { MarkdownHeading } from 'astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  headings: MarkdownHeading[];
  locale: Locale;
  /** 'rail' sits beside the article; 'inline' folds into a disclosure on smaller screens. */
  variant?: 'rail' | 'inline';
}

const { locale, variant = 'rail' } = Astro.props;
const t = useTranslations(locale);
const items = Astro.props.headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const format = JSON.stringify({ n: t.article.minutesLeft(999).replace('999', '{n}'), done: t.article.minutesLeft(0) });
---

{
  items.length > 1 &&
    (variant === 'rail' ? (
      <nav class="toc" aria-labelledby="toc-title">
        <p class="toc__title" id="toc-title">
          {t.article.onThisPage}
        </p>
        <ol>
          {items.map((h) => (
            <li class:list={{ toc__sub: h.depth === 3 }}>
              <a href={`#${h.slug}`} data-toc-link={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
        <p class="toc__left label" data-minutes-left data-format={format} aria-live="off" />
        <a class="toc__top" href="#main" data-back-to-top>
          {t.article.backToTop}
        </a>
      </nav>
    ) : (
      <details class="toc-inline">
        <summary>
          {t.article.onThisPage}
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <ol>
          {items.map((h) => (
            <li class:list={{ toc__sub: h.depth === 3 }}>
              <a href={`#${h.slug}`} data-toc-link={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ))
}

<style>
  .toc {
    font-size: var(--step--1);
  }

  .toc__title {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  .toc ol,
  .toc-inline ol {
    position: relative;
    list-style: none;
    padding: 0;
    border-left: 1px solid var(--hairline);
  }

  .toc li a,
  .toc-inline li a {
    display: block;
    padding: var(--space-1) 0 var(--space-1) var(--space-4);
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--graphite);
    line-height: 1.45;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-base) ease,
      padding-left var(--dur-slow) var(--ease-expo);
  }

  .toc .toc__sub a,
  .toc-inline .toc__sub a {
    padding-left: var(--space-6);
    font-size: var(--step--2);
  }

  .toc li a:hover {
    color: var(--ink);
  }

  .toc li a[aria-current='true'] {
    color: var(--ink);
    border-left-color: var(--accent);
    padding-left: calc(var(--space-4) + 4px);
  }

  .toc .toc__sub a[aria-current='true'] {
    padding-left: calc(var(--space-6) + 4px);
  }

  .toc__left {
    margin-top: var(--space-5);
  }

  .toc__left:empty {
    display: none;
  }

  .toc__top {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--step--2);
    color: var(--graphite);
    transition: color var(--dur-fast) ease;
  }

  .toc__top:hover {
    color: var(--accent);
  }

  .toc-inline {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-m);
    font-size: var(--step--1);
  }

  .toc-inline summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }

  .toc-inline summary::-webkit-details-marker {
    display: none;
  }

  .toc-inline summary svg {
    width: 12px;
    height: 12px;
    transition: transform var(--dur-slow) var(--ease-expo);
  }

  .toc-inline[open] summary svg {
    transform: rotate(180deg);
  }

  .toc-inline ol {
    margin: 0 var(--space-4) var(--space-4);
  }
</style>
