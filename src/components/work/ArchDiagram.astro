---
/**
 * An architecture diagram you can question. Select a part to see what it
 * owns and how it connects; choose a request to watch it travel through
 * the system, step by step. Drawn as SVG on the server; src/scripts/diagram.ts
 * adds the interaction. Without JavaScript it is still a labelled diagram,
 * and the parts are listed below it.
 */
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import type { Diagram, DiagramNode } from '../../work/types';

interface Props {
  diagram: Diagram;
  locale: Locale;
  id: string;
}

const { diagram, locale, id } = Astro.props;
const t = useTranslations(locale);
const W = 150;
const H = 58;

const box = (n: DiagramNode) => ({ x: n.x, y: n.y, w: n.w ?? W, h: n.h ?? H });
const byId = new Map(diagram.nodes.map((n) => [n.id, n]));

/** A smooth connector from one box to another, leaving and entering on facing sides. */
function connector(fromId: string, toId: string, axis?: 'h' | 'v') {
  const a = box(byId.get(fromId)!);
  const b = box(byId.get(toId)!);
  const acx = a.x + a.w / 2;
  const acy = a.y + a.h / 2;
  const bcx = b.x + b.w / 2;
  const bcy = b.y + b.h / 2;
  const dx = bcx - acx;
  const dy = bcy - acy;
  const horizontal = axis ? axis === 'h' : Math.abs(dx) >= Math.abs(dy) * 0.8;
  if (horizontal) {
    const x1 = dx >= 0 ? a.x + a.w : a.x;
    const x2 = dx >= 0 ? b.x : b.x + b.w;
    const mx = (x1 + x2) / 2;
    return { d: `M${x1} ${acy} C${mx} ${acy} ${mx} ${bcy} ${x2} ${bcy}`, lx: mx, ly: (acy + bcy) / 2 };
  }
  const y1 = dy >= 0 ? a.y + a.h : a.y;
  const y2 = dy >= 0 ? b.y : b.y + b.h;
  const my = (y1 + y2) / 2;
  return { d: `M${acx} ${y1} C${acx} ${my} ${bcx} ${my} ${bcx} ${y2}`, lx: (acx + bcx) / 2, ly: my };
}

const edges = diagram.edges.map((e) => ({ ...e, ...connector(e.from, e.to, e.axis) }));

// Text for the script, in this page's language only.
const payload = {
  nodes: Object.fromEntries(diagram.nodes.map((n) => [n.id, { label: n.label, detail: n.detail[locale] }])),
  edges: Object.fromEntries(diagram.edges.map((e) => [e.id, { from: e.from, to: e.to }])),
  traces: diagram.traces.map((tr) => ({
    id: tr.id,
    steps: tr.steps.map((s) => ({ edge: s.edge, node: s.node, note: s.note[locale], blocked: s.blocked ?? false, reverse: s.reverse ?? false })),
  })),
  text: { stepOf: t.work.stepOf(0, 0).replace(/0/g, '{}'), pick: t.work.pick, play: t.work.play, pause: t.work.pause },
};
---

<div class="arch" data-arch={id}>
  <div class="arch__controls">
    <p class="label">{t.work.traces}</p>
    <div class="arch__traces" role="group" aria-label={t.work.traces}>
      {
        diagram.traces.map((tr, i) => (
          <button type="button" class="arch__trace" data-trace={i} aria-pressed="false">
            {tr.label[locale]}
          </button>
        ))
      }
    </div>
  </div>

  <div class="arch__stage">
    <div class="arch__scroll">
      <svg
        class="arch__svg"
        viewBox={`0 0 ${diagram.width} ${diagram.height}`}
        role="group"
        aria-label={t.work.architecture}
        data-arch-svg
      >
        <defs>
          <marker id={`${id}-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1 1L7 4L1 7" fill="none" stroke="context-stroke" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
          </marker>
        </defs>
        <g class="arch__edges">
          {
            edges.map((e) => (
              <g class:list={['edge', { 'edge--dashed': e.dashed }]} data-edge={e.id} data-from={e.from} data-to={e.to}>
                <path class="edge__line" d={e.d} marker-end={`url(#${id}-arrow)`} />
                <path class="edge__flow" d={e.d} />
                {e.label && (
                  <g class="edge__label" transform={`translate(${e.lx} ${e.ly})`}>
                    <text text-anchor="middle" dy="-6">{e.label[locale]}</text>
                  </g>
                )}
              </g>
            ))
          }
        </g>
        <g class="arch__nodes">
          {
            diagram.nodes.map((n) => {
              const b = box(n);
              return (
                <g
                  class:list={['node', `node--${n.tone ?? 'core'}`]}
                  data-node={n.id}
                  transform={`translate(${b.x} ${b.y})`}
                  tabindex="0"
                  role="button"
                  aria-pressed="false"
                  aria-label={`${n.label}${n.sub ? `, ${n.sub[locale]}` : ''}`}
                >
                  <rect class="node__box" width={b.w} height={b.h} rx="10" />
                  <rect class="node__halo" x="-5" y="-5" width={b.w + 10} height={b.h + 10} rx="14" />
                  <text class="node__label" x="14" y={n.sub ? 25 : b.h / 2 + 5}>
                    {n.label}
                  </text>
                  {n.sub && (
                    <text class="node__sub" x="14" y="43">
                      {n.sub[locale]}
                    </text>
                  )}
                </g>
              );
            })
          }
        </g>
        <circle class="arch__packet" r="5" cx="-20" cy="-20" data-packet></circle>
      </svg>
    </div>
    <p class="arch__hint label">{t.work.scrollHint}</p>
  </div>

  <div class="arch__panel" aria-live="polite">
    <div class="arch__readout">
      <p class="arch__step label" data-arch-step></p>
      <p class="arch__title" data-arch-title>{t.work.pick}</p>
      <p class="arch__note" data-arch-note></p>
    </div>
    <div class="arch__buttons">
      <button type="button" class="arch__btn" data-arch-prev aria-label={t.work.prevStep} disabled>
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9 3 5 7l4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button type="button" class="arch__btn arch__btn--play" data-arch-play aria-label={t.work.play} disabled>
        <svg class="icon-play" viewBox="0 0 14 14" aria-hidden="true"><path d="M4.5 3v8l6-4z" fill="currentColor"></path></svg>
        <svg class="icon-pause" viewBox="0 0 14 14" aria-hidden="true"><path d="M4.5 3v8M9.5 3v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
      <button type="button" class="arch__btn" data-arch-next aria-label={t.work.nextStep} disabled>
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="m5 3 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>
    <div class="arch__progress" aria-hidden="true"><span data-arch-progress></span></div>
  </div>

  <details class="arch__list">
    <summary>{t.work.architecture}: {diagram.nodes.length}</summary>
    <dl>
      {
        diagram.nodes.map((n) => (
          <div>
            <dt translate="no">{n.label}</dt>
            <dd>{n.detail[locale]}</dd>
          </div>
        ))
      }
    </dl>
  </details>

  <script type="application/json" data-arch-data set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
</div>

<script>
  import { mountDiagrams } from '../../scripts/diagram';
  document.addEventListener('astro:page-load', mountDiagrams);
</script>

<style>
  .arch {
    display: grid;
    gap: var(--space-4);
  }

  .arch__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .arch__traces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .arch__trace {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    height: 2.125rem;
    padding: 0 0.95rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--ink-soft);
    background: var(--paper-raised);
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      background-color var(--dur-base) ease;
  }

  .arch__trace::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hairline-strong);
    transition: background-color var(--dur-base) ease;
  }

  .arch__trace:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .arch__trace[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .arch__trace[aria-pressed='true']::before {
    background: var(--accent);
  }

  .arch__stage {
    position: relative;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--graphite-soft) 30%, transparent) 1px, transparent 0) 0 0 / 22px 22px,
      var(--paper-tint);
    overflow: hidden;
  }

  .arch__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--hairline-strong) transparent;
  }

  .arch__svg {
    display: block;
    width: 100%;
    min-width: 54rem;
    height: auto;
    padding: clamp(var(--space-3), 2vw, var(--space-5));
    font-family: var(--font-sans);
    overflow: visible;
  }

  .arch__hint {
    display: none;
    padding: 0 var(--space-4) var(--space-3);
  }

  @media (max-width: 54rem) {
    .arch__hint {
      display: block;
    }
  }

  /* Edges */
  .edge__line {
    fill: none;
    stroke: var(--graphite-soft);
    stroke-width: 1.25;
    opacity: 0.55;
    transition:
      stroke var(--dur-base) ease,
      opacity var(--dur-base) ease,
      stroke-width var(--dur-base) ease;
  }

  .edge--dashed .edge__line {
    stroke-dasharray: 4 5;
  }

  .edge__flow {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 3 9;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity var(--dur-base) ease;
  }

  .edge__label text {
    font-size: 11px;
    fill: var(--graphite);
    paint-order: stroke;
    stroke: var(--paper-tint);
    stroke-width: 5px;
    stroke-linejoin: round;
    transition: fill var(--dur-base) ease;
  }

  .edge.is-related .edge__line {
    opacity: 1;
    stroke: var(--ink-soft);
  }

  .edge.is-active .edge__line {
    opacity: 1;
    stroke: var(--accent);
    stroke-width: 1.75;
  }

  .edge.is-active .edge__flow {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .edge.is-active .edge__flow {
      animation: flow 0.9s linear infinite;
    }

    .edge.is-active.is-reverse .edge__flow {
      animation-direction: reverse;
    }
  }

  .edge.is-active .edge__label text {
    fill: var(--accent);
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -12;
    }
  }

  /* Nodes */
  .node {
    cursor: pointer;
    outline: none;
  }

  .node__box {
    fill: var(--paper-raised);
    stroke: var(--hairline-strong);
    stroke-width: 1;
    transition:
      stroke var(--dur-base) ease,
      fill var(--dur-base) ease;
  }

  .node--client .node__box {
    fill: var(--paper-sunken);
  }

  .node--store .node__box {
    stroke-dasharray: none;
    fill: color-mix(in srgb, var(--accent) 4%, var(--paper-raised));
  }

  .node--external .node__box {
    stroke-dasharray: 3 3;
  }

  .node__halo {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    opacity: 0;
    transition: opacity var(--dur-base) ease;
  }

  .node__label {
    font-size: 14px;
    font-weight: 600;
    fill: var(--ink);
    letter-spacing: -0.01em;
  }

  .node__sub {
    font-size: 11px;
    fill: var(--graphite);
  }

  .node:hover .node__box {
    stroke: var(--ink-soft);
  }

  .node:focus-visible .node__halo,
  .node.is-selected .node__halo {
    opacity: 1;
  }

  .node.is-selected .node__box,
  .node.is-active .node__box {
    stroke: var(--accent);
  }

  .node.is-active .node__box {
    fill: var(--accent-wash);
  }

  .node.is-blocked .node__box {
    stroke: var(--warn);
    fill: var(--warn-wash);
  }

  .node.is-blocked .node__halo {
    stroke: var(--warn);
    opacity: 1;
  }

  /* A refusal shakes the part once. (The group's own position is an SVG
     attribute, so the shake moves its children, never the group.) */
  @media (prefers-reduced-motion: no-preference) {
    .node.is-blocked > * {
      animation: refuse 420ms var(--ease-out);
    }
  }

  @keyframes refuse {
    20%,
    60% {
      transform: translateX(-3px);
    }
    40%,
    80% {
      transform: translateX(3px);
    }
  }

  /* The diagram dims what isn't part of the current story */
  .arch[data-focus] .node:not(.is-active, .is-selected, .is-related, .is-blocked) {
    opacity: 0.45;
  }

  .arch[data-focus] .edge:not(.is-active, .is-related) {
    opacity: 0.35;
  }

  .node,
  .edge {
    transition: opacity var(--dur-slow) ease;
  }

  .arch__packet {
    fill: var(--accent);
    opacity: 0;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 60%, transparent));
  }

  .arch__packet.is-moving {
    opacity: 1;
  }

  .arch__packet.is-blocked {
    fill: var(--warn);
  }

  /* Panel: what you selected, or where the request is */
  .arch__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
    min-height: 8.5rem;
  }

  .arch__readout {
    display: grid;
    gap: var(--space-1);
  }

  .arch__step:empty {
    display: none;
  }

  .arch__title {
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: var(--track-heading);
  }

  .arch__note {
    max-width: 44rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .arch__note:empty {
    display: none;
  }

  .arch[data-blocked] .arch__title {
    color: var(--warn);
  }

  .arch__buttons {
    display: flex;
    gap: var(--space-1);
  }

  .arch__btn {
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 50%;
    color: var(--ink);
    transition:
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      opacity var(--dur-fast) ease;
  }

  .arch__btn svg {
    width: 14px;
    height: 14px;
  }

  .arch__btn:hover:not(:disabled) {
    border-color: var(--ink);
  }

  .arch__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .arch__btn--play {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .arch__btn--play .icon-pause,
  .arch[data-playing] .arch__btn--play .icon-play {
    display: none;
  }

  .arch[data-playing] .arch__btn--play .icon-pause {
    display: block;
  }

  .arch__progress {
    grid-column: 1 / -1;
    height: 2px;
    border-radius: 2px;
    background: var(--hairline);
    overflow: hidden;
  }

  .arch__progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
    transition: transform 500ms var(--ease-expo);
  }

  .arch[data-blocked] .arch__progress span {
    background: var(--warn);
  }

  .arch__list {
    font-size: var(--step--1);
    color: var(--graphite);
  }

  .arch__list summary {
    cursor: pointer;
    width: fit-content;
  }

  .arch__list dl {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .arch__list dt {
    font-weight: 600;
    color: var(--ink);
  }

  @media (max-width: 40rem) {
    .arch__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
