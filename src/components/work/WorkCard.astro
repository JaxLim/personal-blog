---
/**
 * A case study as a large card: the story on one side, the product on the
 * other. The whole card is the link; the screenshot drifts with the scroll
 * and a soft light follows the pointer.
 */
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { caseStudyUrl, type CaseStudy } from '../../work';

interface Props {
  study: CaseStudy;
  locale: Locale;
  index: number;
}

const { study, locale, index } = Astro.props;
const t = useTranslations(locale);
const shot = study.screens[0];
const image = locale === 'zh' && shot.zh ? shot.zh : shot.image;
const stack = study.stack.flatMap((g) => g.items).slice(0, 6);
const metrics = study.metrics.slice(0, 2);
const reverse = index % 2 === 1;
---

<div data-reveal="scale">
<article class:list={['work-card', { 'work-card--reverse': reverse }]} data-spotlight>
  <div class="work-card__text">
    <p class="label">
      <span class="label--accent">{String(index + 1).padStart(2, '0')}</span> / {t.work.label} · {study.year}
    </p>
    <h3 class="work-card__name" translate="no">
      <a href={caseStudyUrl(study, locale)} class="work-card__link">{study.name}</a>
    </h3>
    <p class="work-card__tagline">{study.tagline[locale]}</p>
    <dl class="work-card__metrics">
      {
        metrics.map((m) => (
          <div>
            <dt class="work-card__metric" translate="no">{m.value}</dt>
            <dd>{m.label[locale]}</dd>
          </div>
        ))
      }
    </dl>
    <ul class="chips" aria-label={t.work.stack}>
      {stack.map((s) => <li translate="no">{s}</li>)}
    </ul>
    <span class="btn work-card__cta" aria-hidden="true">
      <span class="roll"><span data-text={t.home.caseStudy}>{t.home.caseStudy}</span></span>
      <svg class="btn__icon btn__icon--right" viewBox="0 0 14 14">
        <path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
  <div class="work-card__media" aria-hidden="true">
    <div class="work-card__shot" data-parallax="36">
      <div class="frame">
        <div class="frame__bar"><span class="frame__dots"><i></i><i></i><i></i></span><span class="frame__title">{study.name.toLowerCase()}</span></div>
        <Image src={image} alt="" widths={[640, 960, 1280]} sizes="(min-width: 64rem) 40rem, 92vw" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</article>
</div>

<style>
  .work-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding: clamp(var(--space-5), 3.5vw, var(--space-7));
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    background: var(--paper-tint);
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color var(--dur-slow) ease,
      box-shadow 700ms var(--ease-expo);
  }

  /* A soft light under the pointer */
  .work-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      520px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent) 9%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .work-card:hover {
    border-color: var(--hairline-strong);
    box-shadow: 0 40px 80px -48px rgb(21 23 28 / 0.35);
  }

  .work-card:hover::before {
    opacity: 1;
  }

  @media (min-width: 60rem) {
    .work-card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: var(--space-7);
      min-height: 34rem;
    }

    .work-card--reverse .work-card__text {
      order: 2;
    }
  }

  .work-card__text {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .work-card__name {
    font-size: var(--step-5);
    line-height: 1;
    font-weight: 650;
    letter-spacing: -0.045em;
  }

  /* The name's link covers the whole card */
  .work-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .work-card__link:focus-visible {
    outline: none;
  }

  .work-card:has(.work-card__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .work-card__tagline {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-soft);
    letter-spacing: var(--track-heading);
  }

  :lang(zh) .work-card__tagline,
  :lang(ja) .work-card__tagline {
    font-size: var(--step-0);
    line-height: 1.85;
  }

  .work-card__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-2);
    padding-block: var(--space-4);
    border-block: 1px solid var(--hairline);
  }

  .work-card__metric {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .work-card__metrics dd {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--graphite);
  }

  .work-card__cta {
    justify-self: start;
    margin-top: var(--space-2);
  }

  .work-card:hover .work-card__cta .roll > span {
    transform: translateY(-100%);
  }

  .work-card:hover .work-card__cta .btn__icon--right {
    transform: translateX(3px);
  }

  .work-card__media {
    position: relative;
    perspective: 1200px;
  }

  .work-card__shot {
    transform: translate3d(0, var(--parallax, 0), 0);
    will-change: transform;
  }

  .work-card__shot .frame {
    transform: rotateX(0deg) scale(1);
    transform-origin: 50% 100%;
    transition: transform 900ms var(--ease-expo);
  }

  .work-card:hover .work-card__shot .frame {
    transform: rotateX(4deg) scale(1.015);
  }

  @media (max-width: 59.99rem) {
    .work-card__shot {
      transform: none;
    }
  }
</style>
