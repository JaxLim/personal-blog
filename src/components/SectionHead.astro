---
/**
 * A section's head: an index label in the narrow column, the title and a
 * note in the wide one. Matches the rail layout used across the site.
 */
interface Props {
  index?: string;
  label?: string;
  title: string;
  id: string;
  note?: string;
  link?: { href: string; label: string };
}

const { index, label, title, id, note, link } = Astro.props;
---

<header class="section-head">
  <p class="label">{index && <span class="label--accent">{index}</span>}{index && label && ' / '}{label}</p>
  <div class="section-head__body">
    <h2 class="section-head__title" id={id} data-reveal>{title}</h2>
    {note && <p class="section-head__note" data-reveal style="--reveal-delay:80">{note}</p>}
    {
      link && (
        <a class="btn btn--ghost section-head__link" href={link.href} data-reveal style="--reveal-delay:140">
          <span class="roll"><span data-text={link.label}>{link.label}</span></span>
          <svg class="btn__icon btn__icon--right" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      )
    }
  </div>
</header>
