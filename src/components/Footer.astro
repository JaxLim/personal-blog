---
import { localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { formatLongDate } from '../lib/format';
import { profileLinks, site } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const siteLinks = [
  { label: t.nav.projects, href: localePath(locale, '/projects/') },
  { label: t.nav.writing, href: localePath(locale, '/writing/') },
  { label: t.nav.about, href: localePath(locale, '/about/') },
];
const elsewhere = [
  ...profileLinks(),
  ...(site.email ? [{ label: t.about.email, href: `mailto:${site.email}` }] : []),
  { label: t.footer.rss, href: localePath(locale, '/rss.xml') },
];
const github = site.github.username ? `https://github.com/${site.github.username}` : null;
---

<footer class="footer">
  <div class="page">
    <section class="cta" aria-labelledby="footer-cta">
      <p class="label">{t.about.contact}</p>
      <h2 class="cta__title" id="footer-cta" data-reveal>{t.footer.cta}</h2>
      <div class="cta__row" data-reveal style="--reveal-delay:120">
        <p class="cta__note">{t.footer.ctaNote}</p>
        <div class="cta__actions">
          {
            site.email && (
              <a class="btn" href={`mailto:${site.email}`}>
                <span class="roll"><span data-text={site.email}>{site.email}</span></span>
              </a>
            )
          }
          {
            github && (
              <a class:list={['btn', { 'btn--ghost': Boolean(site.email) }]} href={github} rel="me noopener">
                <svg class="btn__icon" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                  ></path>
                </svg>
                <span class="roll"><span data-text={`github.com/${site.github.username}`}>github.com/{site.github.username}</span></span>
              </a>
            )
          }
        </div>
      </div>
    </section>

    <div class="footer__grid">
      <nav class="footer__col" aria-label={t.footer.site}>
        <p class="label">{t.footer.site}</p>
        <ul>{siteLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="footer__col" aria-label={t.footer.elsewhere}>
        <p class="label">{t.footer.elsewhere}</p>
        <ul>
          {
            elsewhere.map((l) => (
              <li>
                <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="footer__col footer__status">
        <p class="label">{t.about.now}</p>
        <p><span class="live-dot" aria-hidden="true"></span>{site.status[locale]}</p>
      </div>
    </div>

    <div class="footer__base">
      <p>&copy; {year} <span translate="no">{site.name}</span> · {t.footer.built(formatLongDate(new Date(), locale))}</p>
      <a class="footer__top" href="#main" data-back-to-top>
        <span class="roll"><span data-text={t.footer.top}>{t.footer.top}</span></span>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 10V2M2.5 5.5 6 2l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>
  </div>

  <div class="footer__mark" aria-hidden="true" translate="no">
    <span>{site.name}</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--hairline);
    font-size: var(--step--1);
    color: var(--graphite);
    overflow: hidden;
  }

  .cta {
    padding-block: clamp(var(--space-8), 10vw, 9rem) clamp(var(--space-7), 7vw, var(--space-9));
    display: grid;
    gap: var(--space-5);
  }

  .cta__title {
    max-width: 16ch;
    font-size: var(--step-5);
    line-height: 1.02;
    font-weight: 620;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  :lang(zh) .cta__title,
  :lang(ja) .cta__title {
    max-width: 14em;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.25rem);
    line-height: 1.25;
    letter-spacing: 0;
    font-weight: 600;
  }

  .cta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .cta__note {
    max-width: 30rem;
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--graphite);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--hairline);
  }

  .footer__col .label {
    margin-bottom: var(--space-3);
  }

  .footer__col ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .footer__col a {
    color: var(--ink-soft);
    transition: color var(--dur-fast) ease;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__status p:last-child {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-soft);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--hairline);
    font-size: var(--step--2);
    color: var(--graphite-soft);
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--graphite);
  }

  .footer__top svg {
    width: 12px;
    height: 12px;
    transition: transform var(--dur-slow) var(--ease-expo);
  }

  .footer__top:hover {
    color: var(--ink);
  }

  .footer__top:hover svg {
    transform: translateY(-2px);
  }

  /* The name, very large and very quiet, cut off by the bottom edge */
  .footer__mark {
    display: flex;
    justify-content: center;
    height: clamp(4.5rem, 15vw, 13rem);
    margin-top: var(--space-4);
    pointer-events: none;
    user-select: none;
  }

  .footer__mark span {
    font-size: clamp(7rem, 27vw, 24rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.065em;
    color: transparent;
    -webkit-text-stroke: 1px var(--hairline-strong);
    background: linear-gradient(180deg, var(--paper-sunken), transparent 70%);
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>
