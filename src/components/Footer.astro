---
import { localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { formatLongDate } from '../lib/format';
import { site } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const siteLinks = [
  { label: t.nav.writing, href: localePath(locale, '/writing/') },
  { label: t.nav.projects, href: localePath(locale, '/projects/') },
  { label: t.nav.about, href: localePath(locale, '/about/') },
];
const elsewhere = [
  ...(site.github.username ? [{ label: 'GitHub', href: `https://github.com/${site.github.username}` }] : []),
  ...site.links,
  ...(site.email ? [{ label: t.about.email, href: `mailto:${site.email}` }] : []),
  { label: t.footer.rss, href: localePath(locale, '/rss.xml') },
];
---

<footer class="footer">
  <div class="page footer__inner">
    <div class="footer__brand">
      <a class="footer__name" href={localePath(locale, '/')} translate="no">{site.name}</a>
      <p>{site.tagline[locale]}</p>
    </div>
    <nav class="footer__col" aria-label={t.footer.site}>
      <p class="footer__heading">{t.footer.site}</p>
      <ul>{siteLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav class="footer__col" aria-label={t.footer.elsewhere}>
      <p class="footer__heading">{t.footer.elsewhere}</p>
      <ul>
        {
          elsewhere.map((l) => (
            <li>
              <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="page footer__base">
    <p>&copy; {year} <span translate="no">{site.name}</span></p>
    <p>{t.footer.built(formatLongDate(new Date(), locale))}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--hairline);
    font-size: var(--step--1);
    color: var(--graphite);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-6);
  }

  @media (min-width: 52rem) {
    .footer__inner {
      grid-template-columns: minmax(12rem, 3fr) minmax(0, 5fr) minmax(0, 2fr) minmax(0, 2fr);
      column-gap: var(--space-6);
    }

    .footer__brand {
      grid-column: 1 / 3;
    }
  }

  .footer__name {
    font-weight: 650;
    font-size: var(--step-0);
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .footer__brand p {
    margin-top: var(--space-2);
    max-width: 30ch;
    line-height: 1.55;
  }

  :lang(zh) .footer__brand p,
  :lang(ja) .footer__brand p {
    max-width: 20em;
  }

  .footer__heading {
    margin-bottom: var(--space-3);
    font-size: var(--step--2);
    color: var(--graphite-soft);
  }

  .footer__col ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .footer__col a {
    color: var(--ink-soft);
    transition: color var(--dur-fast) ease;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5) var(--space-6);
    border-top: 1px solid var(--hairline);
    font-size: var(--step--2);
    color: var(--graphite-soft);
  }
</style>
