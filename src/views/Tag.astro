---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { LOCALES, localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getTags, type Tag } from '../lib/posts';

interface Props {
  locale: Locale;
  tag: Tag;
}

const { locale, tag } = Astro.props;
const t = useTranslations(locale);

// A tag page exists in another language only if that language uses the tag.
const alternates: Partial<Record<Locale, string>> = {};
for (const l of LOCALES) {
  if ((await getTags(l)).some((x) => x.slug === tag.slug)) alternates[l] = localePath(l, `/tags/${tag.slug}/`);
}
---

<Base locale={locale} title={t.writing.tagTitle(tag.tag)} description={t.writing.tagDescription(tag.tag)} alternates={alternates}>
  <div class="page">
    <header class="intro">
      <a class="back link" href={localePath(locale, '/writing/')}>{t.writing.allWriting}</a>
      <h1 class="intro__title">{tag.tag}</h1>
      <p class="intro__lede">{t.writing.tagLede(tag.posts.length)}</p>
    </header>
    <section class="rail">
      <div class="rail__head">
        <h2 class="rail__title">{t.nav.writing}</h2>
      </div>
      <PostList posts={tag.posts} locale={locale} />
    </section>
  </div>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-size: var(--step--1);
    font-weight: 500;
  }
</style>
