---
import Base from '../layouts/Base.astro';
import { LOCALES, LOCALE_INFO, localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const others = LOCALES.filter((l) => l !== locale);
---

<Base locale={locale} title={t.notFound.title} alternates={{}}>
  <div class="page">
    <header class="intro">
      <p class="code tabular" aria-hidden="true">404</p>
      <h1 class="intro__title">{t.notFound.title}</h1>
      <p class="intro__lede">{t.notFound.body}</p>
      <ul class="actions">
        <li><a class="link" href={localePath(locale, '/')}>{t.notFound.home}</a></li>
        <li><a class="link" href={localePath(locale, '/writing/')}>{t.notFound.writing}</a></li>
      </ul>
      <ul class="others">
        {
          others.map((l) => (
            <li lang={LOCALE_INFO[l].htmlLang}>
              <a href={localePath(l, '/')}>{useTranslations(l).notFound.home}</a>
            </li>
          ))
        }
      </ul>
    </header>
  </div>
</Base>

<style>
  .code {
    margin-bottom: var(--space-4);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    font-weight: 500;
  }

  .others {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin-top: var(--space-7);
    font-size: var(--step--1);
    color: var(--graphite);
  }

  .others a:hover {
    color: var(--ink);
  }
</style>
