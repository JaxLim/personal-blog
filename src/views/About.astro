---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { localePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { profileLinks, site } from '../site.config';
import { caseStudies, caseStudyUrl } from '../work';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const about = site.about[locale];

// Add src/assets/portrait.jpg (or .png / .webp) to show a portrait here.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;

const contact = [
  ...(site.email ? [{ label: t.about.email, value: site.email, href: `mailto:${site.email}` }] : []),
  ...profileLinks().map((l) => ({
    label: l.label,
    value: l.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
    href: l.href,
  })),
  { label: t.footer.rss, value: 'RSS', href: localePath(locale, '/rss.xml') },
];
---

<Base locale={locale} title={t.about.title} description={about.intro[0]}>
  <PageIntro label={`${site.name} — ${t.meta.role}`} title={t.about.title} lede={site.tagline[locale]} />

  <div class="page">
    <section class="rail" aria-labelledby="who">
      <div class="rail__head">
        <p class="label"><span class="label--accent">01</span> / {t.about.who}</p>
        <h2 class="visually-hidden" id="who">{t.about.who}</h2>
        {
          portrait && (
            <Image class="portrait" src={portrait} alt={site.name} widths={[240, 480]} sizes="12rem" loading="eager" />
          )
        }
      </div>
      <div class="about__text" data-reveal>
        {about.intro.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="rail" aria-labelledby="focus">
      <div class="rail__head">
        <p class="label"><span class="label--accent">02</span> / {t.about.focus}</p>
        <h2 class="visually-hidden" id="focus">{t.about.focus}</h2>
      </div>
      <ol class="about__list" data-stagger="80">
        {
          about.focus.map((f, i) => (
            <li data-reveal>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              {f}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="rail" aria-labelledby="principles">
      <div class="rail__head">
        <p class="label"><span class="label--accent">03</span> / {t.about.principles}</p>
        <h2 class="visually-hidden" id="principles">{t.about.principles}</h2>
      </div>
      <ul class="principles" data-stagger="100">
        {about.principles.map((p) => <li data-reveal>{p}</li>)}
      </ul>
    </section>

    <section class="rail" aria-labelledby="proof">
      <div class="rail__head">
        <p class="label"><span class="label--accent">04</span> / {t.projects.caseStudies}</p>
        <h2 class="visually-hidden" id="proof">{t.projects.caseStudies}</h2>
      </div>
      <ul class="studies">
        {
          caseStudies.map((s) => (
            <li data-reveal>
              <a href={caseStudyUrl(s, locale)}>
                <span class="studies__name" translate="no">{s.name}</span>
                <span class="studies__tag">{s.tagline[locale]}</span>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="rail" aria-labelledby="now">
      <div class="rail__head">
        <p class="label"><span class="label--accent">05</span> / {t.about.now}</p>
        <h2 class="visually-hidden" id="now">{t.about.now}</h2>
      </div>
      <p class="now" data-reveal><span class="live-dot" aria-hidden="true"></span>{about.now}</p>
    </section>

    <section class="rail" aria-labelledby="contact">
      <div class="rail__head">
        <p class="label"><span class="label--accent">06</span> / {t.about.contact}</p>
        <h2 class="visually-hidden" id="contact">{t.about.contact}</h2>
      </div>
      <dl class="contact" data-reveal>
        {
          contact.map((c) => (
            <div>
              <dt class="label">{c.label}</dt>
              <dd>
                <a class="link" href={c.href} rel={c.href.startsWith('http') ? 'me noopener' : undefined}>
                  {c.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Base>

<style>
  .portrait {
    width: 12rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-top: var(--space-4);
    border-radius: var(--radius-l);
    filter: saturate(0.85);
  }

  .about__text {
    display: grid;
    gap: 1em;
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: clamp(var(--prose-size), 1rem + 0.6vw, 1.5rem);
    line-height: 1.6;
    color: var(--ink);
  }

  :lang(zh) .about__text,
  :lang(ja) .about__text {
    font-size: clamp(var(--prose-size), 0.95rem + 0.4vw, 1.25rem);
    line-height: 1.95;
  }

  .about__list {
    max-width: var(--measure);
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--hairline-strong);
  }

  .about__list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .about__list .label {
    padding-top: 0.3em;
    color: var(--accent);
  }

  .principles {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .principles li {
    font-size: clamp(var(--step-1), 1rem + 1.2vw, var(--step-3));
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  :lang(zh) .principles li,
  :lang(ja) .principles li {
    letter-spacing: 0;
    line-height: 1.5;
    font-size: clamp(var(--step-0), 0.95rem + 0.8vw, var(--step-2));
  }

  .principles li:nth-child(even) {
    color: var(--graphite);
  }

  .studies {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--hairline-strong);
  }

  .studies a {
    display: grid;
    grid-template-columns: 11rem 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }

  .studies__name {
    font-weight: 650;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    transition: color var(--dur-fast) ease;
  }

  .studies__tag {
    color: var(--graphite);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .studies svg {
    width: 16px;
    height: 16px;
    color: var(--graphite);
    transition: transform var(--dur-slow) var(--ease-expo);
  }

  .studies a:hover .studies__name {
    color: var(--accent);
  }

  .studies a:hover svg {
    transform: translateX(4px);
    color: var(--ink);
  }

  @media (max-width: 40rem) {
    .studies a {
      grid-template-columns: 1fr auto;
    }

    .studies__tag {
      grid-column: 1;
    }
  }

  .now {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
  }

  .now .live-dot {
    transform: translateY(-0.15em);
  }

  .contact {
    display: grid;
    max-width: var(--measure);
    border-top: 1px solid var(--hairline-strong);
  }

  .contact div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }

  .contact dt {
    padding-top: 0.35rem;
  }
</style>
