---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const about = site.about[locale];

// Add src/assets/portrait.jpg (or .png / .webp) to show a portrait here.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;

const contact = [
  ...(site.email ? [{ label: t.about.email, value: site.email, href: `mailto:${site.email}` }] : []),
  ...(site.github.username
    ? [{ label: 'GitHub', value: `@${site.github.username}`, href: `https://github.com/${site.github.username}` }]
    : []),
  ...site.links.map((l) => ({
    label: l.label,
    value: l.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
    href: l.href,
  })),
];
---

<Base locale={locale} title={t.about.title} description={about.intro[0]}>
  <div class="page">
    <header class="intro">
      <h1 class="intro__title">{t.about.title}</h1>
    </header>

    <section class="rail" aria-labelledby="who">
      <div class="rail__head">
        <h2 class="rail__title" id="who">{t.about.who}</h2>
        {
          portrait && (
            <Image class="portrait" src={portrait} alt={site.name} widths={[240, 480]} sizes="12rem" loading="eager" />
          )
        }
      </div>
      <div class="about__text">
        {about.intro.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="rail" aria-labelledby="focus">
      <div class="rail__head">
        <h2 class="rail__title" id="focus">{t.about.focus}</h2>
      </div>
      <ul class="about__list">
        {about.focus.map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <section class="rail" aria-labelledby="now">
      <div class="rail__head">
        <h2 class="rail__title" id="now">{t.about.now}</h2>
      </div>
      <div class="about__text">
        <p>{about.now}</p>
      </div>
    </section>

    {
      contact.length > 0 && (
        <section class="rail" aria-labelledby="contact">
          <div class="rail__head">
            <h2 class="rail__title" id="contact">{t.about.contact}</h2>
          </div>
          <dl class="contact">
            {contact.map((c) => (
              <div>
                <dt>{c.label}</dt>
                <dd>
                  <a class="link" href={c.href} rel={c.href.startsWith('http') ? 'me noopener' : undefined}>
                    {c.value}
                  </a>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </div>
</Base>

<style>
  .portrait {
    width: 12rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-top: var(--space-4);
    border-radius: var(--radius-m);
    filter: saturate(0.9);
  }

  .about__text {
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: var(--prose-size);
    line-height: var(--leading-prose);
    color: var(--ink-soft);
  }

  .about__text p + p {
    margin-top: 1em;
  }

  .about__list {
    max-width: var(--measure);
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--hairline-strong);
  }

  .about__list li {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--hairline);
    color: var(--ink-soft);
  }

  .contact {
    display: grid;
    max-width: var(--measure);
    border-top: 1px solid var(--hairline-strong);
  }

  .contact div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }

  .contact dt {
    color: var(--graphite);
    font-size: var(--step--1);
    padding-top: 0.15rem;
  }
</style>
