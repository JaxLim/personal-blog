---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { DEFAULT_LOCALE, LOCALES, LOCALE_INFO, localePath, splitLocale, withBase, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../site.config';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** 'article' adds Open Graph article metadata. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  /**
   * This page in other languages, as paths. Defaults to the same page in
   * every language; posts pass only the translations that exist.
   */
  alternates?: Partial<Record<Locale, string>>;
  /** Structured data for search engines. */
  jsonLd?: Record<string, unknown>;
  /** Link preview image, as a site path without the sub-path (generated in src/pages/og/). */
  ogImage?: string;
}

const { locale, title, description = site.description[locale], type = 'website', publishedAt, jsonLd } = Astro.props;
const t = useTranslations(locale);
const info = LOCALE_INFO[locale];

const { path } = splitLocale(Astro.url.pathname);
const alternates: Partial<Record<Locale, string>> =
  Astro.props.alternates ?? Object.fromEntries(LOCALES.map((l) => [l, localePath(l, path)]));

const pageTitle = title ? `${title} | ${site.name}` : `${site.name}, ${t.meta.role}`;
const origin = Astro.site ?? new URL('https://jaxlim.github.io');
const canonical = new URL(Astro.url.pathname, origin);
const abs = (p: string) => new URL(p, origin).href;
const ogImage = abs(withBase(Astro.props.ogImage ?? `/og/${locale}/site.png`));

// Self-hosted CJK text serifs, copied into public/fonts by scripts/copy-fonts.mjs.
const cjkFont = { en: null, zh: withBase('/fonts/noto-serif-sc/index.css'), ja: withBase('/fonts/noto-serif-jp/index.css') }[locale];

// Main content cross-fades and rises; keyframes live in global.css.
const mainAnimation = {
  old: { name: 'vt-fade-out', duration: '200ms', easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fillMode: 'both' },
  new: { name: 'vt-rise-in', duration: '560ms', delay: '80ms', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
};
const mainTransition = { forwards: mainAnimation, backwards: mainAnimation };
---

<!doctype html>
<html lang={info.htmlLang} data-locale={locale} data-home={localePath(DEFAULT_LOCALE, '/')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {
      (Object.entries(alternates) as [Locale, string][]).map(([l, p]) => (
        <link rel="alternate" hreflang={LOCALE_INFO[l].htmlLang} href={abs(p)} data-locale={l} data-path={p} />
      ))
    }
    {alternates[DEFAULT_LOCALE] && <link rel="alternate" hreflang="x-default" href={abs(alternates[DEFAULT_LOCALE]!)} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: ${t.nav.writing}`} href={localePath(locale, '/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f13" media="(prefers-color-scheme: dark)" />
    {cjkFont && <link rel="stylesheet" href={cjkFont} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? `${site.name}, ${t.meta.role}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={info.og} />
    {
      (Object.keys(alternates) as Locale[])
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={LOCALE_INFO[l].og} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? site.name} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!--
      Before first paint:
      1. mark that scripts run (reveals start hidden only then);
      2. apply the saved theme;
      3. if the reader chose another language before, open this page in it;
      4. on a first visit to the home page, follow the browser's language once.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        const read = (k) => { try { return localStorage.getItem(k); } catch { return null; } };
        const applyTheme = (doc) => {
          const theme = read('theme');
          if (theme === 'light' || theme === 'dark') doc.documentElement.dataset.theme = theme;
          else delete doc.documentElement.dataset.theme;
          doc.documentElement.classList.add('js');
        };
        applyTheme(document);
        document.addEventListener('astro:before-swap', (e) => applyTheme(e.newDocument));

        const current = root.dataset.locale;
        const saved = read('lang');
        const target = (l) => document.querySelector('link[rel=alternate][data-locale="' + l + '"]')?.dataset.path;
        if (saved && saved !== current) {
          const path = target(saved);
          if (path) location.replace(path + location.hash);
          return;
        }
        if (!saved && location.pathname === root.dataset.home) {
          try {
            if (sessionStorage.getItem('lang-checked')) return;
            sessionStorage.setItem('lang-checked', '1');
          } catch { return; }
          const pref = (navigator.languages || [navigator.language]).map((l) => l.toLowerCase())[0] || '';
          const match = pref.startsWith('zh') ? 'zh' : pref.startsWith('ja') ? 'ja' : null;
          if (match && target(match)) location.replace(target(match));
        }
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="route-progress" data-route-progress aria-hidden="true" transition:persist="route-progress"></div>
    <Header locale={locale} alternates={alternates} />
    <main id="main" transition:name="main" transition:animate={mainTransition}>
      <slot />
    </main>
    <Footer locale={locale} />
    <SearchDialog locale={locale} />
    <dialog class="lightbox" data-lenis-prevent data-lightbox aria-label={t.article.enlarge}>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
    </dialog>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import '../scripts/motion';
      import '../scripts/ui';
    </script>
  </body>
</html>
