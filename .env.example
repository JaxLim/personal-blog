# Public URL of the deployed site, used for canonical links, RSS and the sitemap.
SITE_URL=https://example.com

# Optional. A GitHub token (no scopes needed for public data) raises the API
# rate limit at build time and enables the exact daily contribution calendar.
# Create one at https://github.com/settings/tokens  (fine-grained, read-only).
# It is only used during the build and is never sent to the browser.
GITHUB_TOKEN=
